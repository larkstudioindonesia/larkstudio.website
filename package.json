{
  "name": "lark-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "npm run audit:assets && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit:assets": "tsx scripts/audit-assets.ts",
    "verify": "npm run typecheck && npm run lint && npm run audit:assets",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "test-storybook"
  },
  "dependencies": {
    "framer-motion": "11.15.0",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@napi-rs/canvas": "1.0.3",
    "@next/eslint-plugin-next": "15.1.6",
    "@storybook/addon-a11y": "8.4.7",
    "@storybook/addon-essentials": "8.4.7",
    "@storybook/addon-viewport": "8.4.7",
    "@storybook/nextjs": "8.4.7",
    "@storybook/react": "8.4.7",
    "@storybook/test-runner": "0.20.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "axe-playwright": "2.0.3",
    "eslint": "9.17.0",
    "pdfjs-dist": "6.2.108",
    "postcss": "8.4.49",
    "sharp": "0.33.5",
    "storybook": "8.4.7",
    "tailwindcss": "4.3.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1"
  }
}
